# ============ DATABASE (PostgreSQL / Neon) ============
# Connection string completa, da Neon -> Connection Details
DATABASE_URL=postgresql://utente:password@host/nomedb?sslmode=require

# ============ SERVER ============
PORT=3000
# In locale puoi usare development; online production. Ora funziona in entrambi i casi.
NODE_ENV=production

# Stringa lunga e casuale, usata per firmare le sessioni admin. Generane una nuova, non usare questa.
SESSION_SECRET=cambia_questa_stringa_con_qualcosa_di_lungo_e_casuale

# ============ ADMIN (creato automaticamente al primo avvio se non esiste) ============
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_questa_password

# Se non riesci ad entrare perché la password nel DB è diversa da questa, metti true,
# riavvia una volta (username e password admin vengono riallineati al .env) e poi RIMUOVI la riga.
# ADMIN_RESET=true
